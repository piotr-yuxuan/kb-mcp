          "expr": "sum by (kb_mcp_surface) (last_over_time(kb_mcp_eval_agent_tokens_sum{job=\"kb-mcp\"}[$__range])) / sum by (kb_mcp_surface) (last_over_time(kb_mcp_eval_agent_tokens_count{job=\"kb-mcp\"}[$__range]))",
