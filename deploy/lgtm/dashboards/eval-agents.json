        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, kb_mcp_surface) (last_over_time(kb_mcp_eval_agent_call_duration_seconds_bucket{job=\"kb-mcp\"}[$__range])))",
          "instant": true,
          "range": false,
          "legendFormat": "{{kb_mcp_surface}}"
