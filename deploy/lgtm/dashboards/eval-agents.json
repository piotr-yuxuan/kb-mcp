        "x": 0,
        "y": 20,
        "w": 24,
        "h": 10
      },
      "type": "logs",
      "title": "Failed or refused, from the logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"kb-mcp\"} | command=\"eval-agents\" | severity_number >= 13",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    },
