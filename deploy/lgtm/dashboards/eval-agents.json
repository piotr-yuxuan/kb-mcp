{
  "uid": "kb-mcp-eval-agents",
  "title": "eval-agents",
  "description": "The eval-agents runs in the time range: the agents' calls through the bridge by surface and tool, their tokens and time, and the runs judged by outcome.",
  "tags": [
    "kb-mcp"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "",
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "links": [],
  "panels": [
